#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [ -x .venv/bin/ruff ]; then
    ruff=.venv/bin/ruff
elif command -v ruff >/dev/null 2>&1; then
    ruff=ruff
else
    echo 'pre-commit: Ruff is unavailable; install the dev dependencies.' >&2
    exit 1
fi

"$ruff" check --fix .
"$ruff" format .

git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r path; do
    if ! git diff-files --quiet -- "$path"; then
        echo "pre-commit: $path differs from its staged version; review and restage it." >&2
        exit 1
    fi
done
